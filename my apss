            </button>

        </section>
    </main>

    <script>
        let base64Image = "";
        const apiKey = "AIzaSyCuPyRk-xQ5n4iSMcxZI6QpoS05JNwuPHo"; 

        function previewImage(event) {
            const file = event.target.files[0];
            
            if (!file) return; 

            const reader = new FileReader();
            reader.onload = function() {
                base64Image = reader.result.split(',')[1];
                document.getElementById('img-preview').src = reader.result;
                document.getElementById('grid-img-1').src = reader.result;
                document.getElementById('upload-placeholder').classList.add('hidden');
                document.getElementById('preview-container').classList.remove('hidden');
            }
            reader.readAsDataURL(file);
        }

        async function processBranding() {
            const desc = document.getElementById('brand-desc').value;
            const vibe = document.getElementById('vibe-select').value;

            if (!base64Image || !desc) {
                alert("SYSTEM ERROR: INPUT DATA MISSING.");
                return;
            }

            document.getElementById('input-section').classList.add('hidden');
            document.getElementById('loading').classList.remove('hidden');
            document.getElementById('drop-area').classList.add('scanning');

            // Prompt diubah: Memaksa AI menghasilkan kode logo SVG dan struktur warna khusus UI/Brand
            const prompt = `Anda adalah Brand Agency Elite. Pengguna menginginkan aset jualan SIAP PAKAI dengan LOGO dan WARNA berkualitas tinggi.
            Produk: ${desc}. 
            Nuansa: ${vibe}. 
            
            TUGAS:
            1. Buat Palet Warna yang SANGAT HARMONIS dan tidak norak. Pastikan warna kontras satu sama lain untuk desain.
            2. Desain LOGO berupa kode SVG murni. Harus minimalis, elegan, dan menggambarkan produk. (Format: HANYA tag <svg viewBox="0 0 100 100" fill="currentColor"> dan <path>/<rect>/<circle> didalamnya. Jangan pakai script/style aneh, cukup bentuk geometris simple).
            3. Berikan copywriting siap copas.
            
            Output JSON WAJIB sesuai format ini:
            { 
                "name": "Nama Brand (Elegan/Komersil)", 
                "tagline": "Slogan Bisnis", 
                "ig_bio": "Bio IG siap pakai dengan emoji & CTA",
                "ad_headline": "Judul Iklan Super Hook",
                "ad_body": "Teks Iklan lengkap siap copas",
                "content_ideas": ["Ide Video 1", "Ide Video 2", "Ide Video 3"],
                "hashtags": "#hashtag1 #hashtag2",
                "colors": {
                    "primary": "Hex color utama (warna brand)",
                    "secondary": "Hex color pendukung",
                    "accent": "Hex color mencolok (untuk tombol)",
                    "background": "Hex color sangat gelap/sangat terang untuk latar",
                    "text": "Hex color yang kontras dengan background untuk teks"
                }, 
                "typography": {"head": "Montserrat", "body": "Open Sans"}, 
                "logic": "Alasan singkat psikologi di balik warna & bentuk logo ini.",
                "logo_svg": "<svg viewBox='0 0 100 100' fill='currentColor'>...</svg>"
            }`;

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{
                            parts: [
                                { text: prompt },
                                { inlineData: { mimeType: "image/png", data: base64Image } }
                            ]
                        }],
                        generationConfig: { responseMimeType: "application/json" }
                    })
                });

                const data = await response.json();
                const result = JSON.parse(data.candidates[0].content.parts[0].text);
                renderResults(result);

            } catch (error) {
                console.error(error);
                alert("CONNECTION FAILED. RETRY.");
                document.getElementById('loading').classList.add('hidden');
                document.getElementById('input-section').classList.remove('hidden');
                document.getElementById('drop-area').classList.remove('scanning');
            }
        }

        function renderResults(data) {
            document.getElementById('drop-area').classList.remove('scanning');
            document.getElementById('loading').classList.add('hidden');
            document.getElementById('result-section').classList.remove('hidden');

            // 1. Dynamic Font Loading
            const headFont = data.typography.head.replace(/\s+/g, '+');
            const bodyFont = data.typography.body.replace(/\s+/g, '+');
            const fontLink = document.createElement('link');
            fontLink.href = `https://fonts.googleapis.com/css2?family=${headFont}:wght@700;900&family=${bodyFont}:wght@400;500&display=swap`;
            fontLink.rel = 'stylesheet';
            document.head.appendChild(fontLink);

            // 2. Render Concept Showcase (Logo + Typography + Colors)
            const showcasePanel = document.getElementById('brand-showcase-panel');
            const mockupBg = document.getElementById('mockup-bg');
            const resName = document.getElementById('res-name');
            const resTagline = document.getElementById('res-tagline');
            const logoSvgContainer = document.getElementById('res-logo-svg');

            showcasePanel.style.borderTopColor = data.colors.accent;
            mockupBg.style.backgroundColor = data.colors.background;
            
            resName.innerText = data.name;
            resName.style.fontFamily = `'${data.typography.head}', sans-serif`;
            resName.style.color = data.colors.primary;
            
            resTagline.innerText = data.tagline.toUpperCase();
            resTagline.style.fontFamily = `'${data.typography.body}', sans-serif`;
            resTagline.style.color = data.colors.text;

            logoSvgContainer.innerHTML = data.logo_svg;
            logoSvgContainer.style.color = data.colors.accent;
            
            // 3. Render Ready-to-use Assets
            document.getElementById('res-bio').innerText = data.ig_bio;
            document.getElementById('res-ad-head').innerText = `"${data.ad_headline}"`;
            document.getElementById('res-ad-body').innerText = data.ad_body;
            document.getElementById('res-hashtags').innerText = data.hashtags;

            const contentList = document.getElementById('res-content-list');
            contentList.innerHTML = '';
            data.content_ideas.forEach(idea => {
                const li = document.createElement('li');
                li.innerText = idea;
                contentList.appendChild(li);
            });

            // 4. Render Structured Color Grid
            const colorGrid = document.getElementById('color-grid');
            colorGrid.innerHTML = '';
            const colorRoles = [
                { role: 'PRIMARY', hex: data.colors.primary },
                { role: 'SECOND', hex: data.colors.secondary },
                { role: 'ACCENT', hex: data.colors.accent },
                { role: 'BG', hex: data.colors.background },
                { role: 'TEXT', hex: data.colors.text }
            ];

            colorRoles.forEach((c) => {
                colorGrid.innerHTML += `
                    <div class="flex flex-col items-center gap-1">
                        <div class="w-full aspect-square border border-cyan-500/30 rounded-sm relative group shadow-lg" style="background: ${c.hex};">
                            <div class="absolute inset-0 bg-white/0 group-hover:bg-white/20 transition-all cursor-crosshair" onclick="navigator.clipboard.writeText('${c.hex}'); alert('Copied: ${c.hex}')"></div>
                        </div>
                        <span class="text-[7px] font-mono text-cyan-500 uppercase">${c.role}</span>
                        <span class="text-[8px] font-mono text-white">${c.hex}</span>
                    </div>
                `;
            });
            
            document.getElementById('res-reasoning').innerText = `> DESIGN_LOGIC: ${data.logic}`;
            document.getElementById('res-font-head').innerText = data.typography.head;
            document.getElementById('res-font-body').innerText = data.typography.body;

            // 5. Apply Colors to System Applications Grid
            const bLogo = document.getElementById('box-logo');
            bLogo.innerHTML = data.logo_svg; // Insert SVG instead of letter
            bLogo.style.color = data.colors.background;
            
            document.getElementById('grid-2').style.backgroundColor = data.colors.primary;
            document.getElementById('grid-2').style.borderColor = data.colors.accent;
            document.getElementById('grad-color').style.background = `radial-gradient(circle at center, ${data.colors.accent}, transparent)`;
            
            document.getElementById('grid-4').style.background = `repeating-linear-gradient(45deg, ${data.colors.background}, ${data.colors.background} 10px, ${data.colors.secondary} 10px, ${data.colors.secondary} 20px)`;
            document.getElementById('grid-4').style.borderColor = data.colors.primary;

            document.getElementById('overlay-color').style.backgroundColor = data.colors.primary;
            document.getElementById('overlay-color').style.opacity = '0.3';
        }
    </script>
</body>
