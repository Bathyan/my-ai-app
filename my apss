<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Basthyan Brand-Bot AI | Premium Tech HUD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #030712; 
            color: #e5e7eb;
            -webkit-tap-highlight-color: transparent;
            background-image: 
                linear-gradient(rgba(6, 182, 212, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(6, 182, 212, 0.03) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        
        .tech-panel {
            background: rgba(3, 7, 18, 0.6);
            border: 1px solid rgba(6, 182, 212, 0.15);
            backdrop-filter: blur(10px);
            position: relative;
        }
        .tech-panel::before {
            content: ''; position: absolute; top: 0; left: 0; width: 10px; height: 10px;
            border-top: 2px solid #06b6d4; border-left: 2px solid #06b6d4;
        }
        .tech-panel::after {
            content: ''; position: absolute; bottom: 0; right: 0; width: 10px; height: 10px;
            border-bottom: 2px solid #06b6d4; border-right: 2px solid #06b6d4;
        }

        .cyber-btn {
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid #06b6d4;
            color: #22d3ee;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
        }
        .cyber-btn:active {
            background: #06b6d4;
            color: #000;
            box-shadow: 0 0 20px #06b6d4;
        }

        .scanner-line {
            position: absolute;
            width: 100%;
            height: 2px;
            background: #06b6d4;
            box-shadow: 0 0 10px #06b6d4, 0 0 20px #06b6d4;
            top: 0; left: 0;
            animation: scan 2.5s ease-in-out infinite;
            opacity: 0;
            z-index: 20;
        }
        .scanning .scanner-line { opacity: 1; }

        @keyframes scan {
            0% { top: 0; }
            50% { top: 100%; }
            100% { top: 0; }
        }

        .glitch-text {
            animation: glitch 3s infinite;
        }
        @keyframes glitch {
            0%, 100% { text-shadow: none; }
            92% { text-shadow: 2px 0 #06b6d4, -2px 0 #ec4899; }
            94% { text-shadow: -2px 0 #06b6d4, 2px 0 #ec4899; }
            96% { text-shadow: 2px 0 #06b6d4, -2px 0 #ec4899; }
        }

        /* Aturan khusus untuk eksport ke PDF */
        @media print {
            body {
                background-color: #030712 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print { display: none !important; }
            #input-section, #loading, header { display: none !important; }
            main { max-width: 100% !important; margin: 0 !important; padding: 20px !important; }
            #result-section { display: block !important; padding-bottom: 0 !important; }
            .tech-panel { break-inside: avoid; page-break-inside: avoid; }
            /* Sembunyikan tombol cetak di dalam PDF */
            .export-btn-print { display: none !important; }
        }
    </style>
</head>
<body class="antialiased selection:bg-cyan-500/30">

